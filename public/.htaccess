# Disable content-negotiation that can cause 404s on pretty URLs Options
-MultiViews RewriteEngine On RewriteBase / # Let real files and folders pass
through RewriteCond %{REQUEST_FILENAME} -f [OR] RewriteCond %{REQUEST_FILENAME}
-d RewriteRule ^ - [L] # Send everything else to index.html RewriteRule ^
index.html [L]

<!-- This will prevent 404 error for ramitusa.com/about direct navigation -->
